---
/* The hub: the two sections of the site, and where to pick up. */
import AiLayout from '../layouts/AiLayout.astro';
import Icon from '../components/Icon.astro';
import JumpBackIn from '../components/ai/JumpBackIn';
import { all, PAGE } from '../data/catalog';
import { tracks, units } from '../lib/ai/course';
import { quizzes } from '../lib/ai/quizzes';

const walkthroughs = all.filter((p) => PAGE[p.id]).length;
const modules = tracks.reduce((a, t) => a + t.modules.length, 0);
const questions = Object.values(quizzes).reduce((a, q) => a + q.length, 0);
---
<AiLayout section="hub" where="Home" title="Home" description="LeetCode walkthroughs you can step through, and a self-study path from backend engineer to AI research engineer.">
  <div class="kicker">learn.devmtnaing.com</div>
  <h1 class="page-h">Practise the interview. Then go deeper.</h1>
  <p class="page-sub">
    LeetCode problems you can step through one state change at a time, and a self-study path from backend engineer
    to AI research engineer. XP, streaks and your daily goal count across both.
  </p>
  <JumpBackIn client:only="preact" units={units} />
  <h2 class="section-title">Sections</h2>
  <div class="hub-sections">
    <a class="hub-card tc-teal" href="/leetcode">
      <div class="kicker" style="color:var(--ct)">LeetCode</div>
      <h2>Interview problems</h2>
      <p>Grouped by pattern. Each walkthrough quotes the problem, steps through the algorithm and ends with tested code in Ruby, Python, JavaScript, Go and Rust.</p>
      <div class="hub-stats">
        <span><b>{all.length}</b>problems</span>
        <span><b>{walkthroughs}</b>walkthroughs</span>
        <span><b>5</b>languages</span>
      </div>
      <span class="go">Browse problems <Icon name="chevron" size={16} /></span>
    </a>
    <a class="hub-card tc-indigo" href="/ai-engineer">
      <div class="kicker" style="color:var(--ct)">AI Engineer</div>
      <h2>Backend → research engineer</h2>
      <p>Three tracks, each a job you can be hired for: AI application, ML systems, research. Concepts, resources, builds, quizzes and checkpoints.</p>
      <div class="hub-stats">
        <span><b>{modules}</b>modules</span>
        <span><b>{questions}</b>quiz questions</span>
        <span><b>{units.length}</b>steps</span>
      </div>
      <span class="go">Open the path <Icon name="chevron" size={16} /></span>
    </a>
  </div>
</AiLayout>
