---
/* Served for any path that is not a page (wrangler.jsonc: not_found_handling). */
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
---
<Base title={`Not found · ${SITE_NAME}`} description="There is no page at this address.">
  <div class="shell">
    <div class="page-head">
      <h1>Not found</h1>
      <p class="lede">There is no page at this address. Try the <a href="/">home page</a>, the <a href="/leetcode">LeetCode problems</a> or the <a href="/ai-engineer">AI Engineer path</a>.</p>
    </div>
  </div>
</Base>
