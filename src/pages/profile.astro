---
import AiLayout from '../layouts/AiLayout.astro';
import Profile from '../components/ai/Profile';
import { tracks, trackUrl, units } from '../lib/ai/course';
const summary = tracks.map((t) => ({
  id: t.id, url: trackUrl(t), short: t.short, title: t.title, color: t.color,
  units: units.filter((u) => u.track === t.id).map((u) => u.id),
  modules: t.modules.map((m) => m.id),
}));
---
<AiLayout section="hub" title="Profile" description="Your progress across the site." where="Profile">
  <div class="kicker">Profile</div>
  <h1 class="page-h">Your progress</h1>
  <p class="page-sub">XP and streaks count across the whole site.</p>
  <Profile client:only="preact" tracks={summary} />
</AiLayout>
