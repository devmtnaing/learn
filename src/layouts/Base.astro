---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import '../styles/app.css';
import AppRail from '../components/AppRail.astro';
import SectionNav from '../components/SectionNav.astro';
import { sectionOf } from '../data/sections';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSearch from '../components/SiteSearch.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  /** Picks the accent: LeetCode pages are teal, the hub and AI Engineer indigo. */
  section?: 'hub' | 'leetcode' | 'ai';
  /** Shown at the left of the top bar. */
  where?: string;
  /** A focused page (a lesson session) with no sidebar, top bar or footer. */
  bare?: boolean;
}
const { title, description, section = 'hub', where, bare = false } = Astro.props;
// Pages build as .html files (astro.config.mjs) but are served without the
// extension, so the canonical address drops it: /leetcode/two-sum, not .html.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const hasRail = Astro.slots.has('rail');
// the hub and the profile belong to no section, so they have no section menu
const current = sectionOf(section);
---
<!doctype html>
<html lang="en" data-section={section}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+Myanmar:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700&display=swap" />
  <!-- Blocking on purpose: a stored theme and sidebar state have to land on
       <html> before the first paint, or every visit starts with a flash. -->
  <script is:inline>
    try {
      var t = localStorage.getItem('learn-theme');
      if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      if (localStorage.getItem('learn-nav') === 'collapsed') document.documentElement.setAttribute('data-nav', 'collapsed');
    } catch (e) {}
  </script>
</head>
{bare ? (
  <body class="bare"><slot /></body>
) : (
  <body>
    <div class:list={['app', current && 'has-nav', hasRail && 'has-rail']}>
      <AppRail section={section} hasNav={!!current} />
      {current && <SectionNav section={current} />}
      <div class="app-main">
        <header class="app-top">
          <span class="app-where">{where}</span>
          <SiteSearch />
          <ThemeToggle />
        </header>
        {current && <SectionNav section={current} variant="strip" />}
        <main><slot /></main>
        <SiteFooter />
      </div>
      {hasRail && <aside class="app-rail" aria-label="Your progress"><slot name="rail" /></aside>}
    </div>
  </body>
)}
</html>
