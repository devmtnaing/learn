---
interface Props { size?: number }
const { size = 36 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <defs><linearGradient id="logo-g" x1="0" y1="0" x2="40" y2="40"><stop stop-color="#7B6DFF" /><stop offset="1" stop-color="#0FA3A3" /></linearGradient></defs>
  <rect width="40" height="40" rx="11" fill="url(#logo-g)" />
  <path d="M12 27 20 15 28 25" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" />
  <circle cx="12" cy="27" r="3.2" fill="#fff" /><circle cx="20" cy="15" r="3.2" fill="#fff" /><circle cx="28" cy="25" r="3.2" fill="#fff" />
  <circle cx="31" cy="9" r="3.4" fill="#fff" />
</svg>
